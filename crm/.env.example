# ---------------------------------------------------------------------------
# Public (exposed to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Canonical public URL of this deployment (used in e-mails, Stripe redirects, portal links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ClearEntry Teams"

# ---------------------------------------------------------------------------
# Server only -- never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Needed for the applicant portal, Stripe webhooks, GDPR erasure and the cron job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (billing). Leave empty to hide the upgrade checkout in local development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Shared secret that protects /api/cron/daily (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# E-mail provider: "console" (logs to the server output), or "resend"
EMAIL_PROVIDER=console
EMAIL_FROM="ClearEntry Teams <no-reply@example.com>"
RESEND_API_KEY=
