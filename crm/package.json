{
  "name": "clearentry-teams",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant CRM and live analytics dashboard for EU/Schengen visa cases",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "bash scripts/test-db.sh",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "bash scripts/pg-local.sh start",
    "db:local:stop": "bash scripts/pg-local.sh stop",
    "db:types": "supabase gen types typescript --local > src/lib/database.generated.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "stack:start": "bash scripts/dev-stack/stack.sh start",
    "stack:reset": "bash scripts/dev-stack/stack.sh start --reset",
    "stack:stop": "bash scripts/dev-stack/stack.sh stop",
    "stack:env": "bash scripts/dev-stack/stack.sh env"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "type": "module"
}